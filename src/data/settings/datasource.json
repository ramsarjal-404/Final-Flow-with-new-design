        "id": "service",
        "title": "Enable WinRM Service",
        "body": [
          "Ensure that the Windows Remote Management (WinRM) service is enabled and running on both systems."
        ]
      },
      {
        "id": "hosts",
        "title": "Configure Trusted Hosts",
        "body": [
          "Run the following command on the LDSP Host using PowerShell or Command Prompt with Administrator privileges.",
          "Trust All Servers (Not Recommended)",
          "`winrm set winrm/config/client @{TrustedHosts=\"*\"}`",
          "Trust a Specific Server (Recommended)",
          "`winrm set winrm/config/client @{TrustedHosts=\"192.168.1X.1XX\"}`",
          "Incorrect TrustedHosts configuration may cause remote scanning or policy execution failures."
        ]
      },
      {
        "id": "ps",
        "title": "Configure PowerShell Script Execution",
        "body": [
          "Open the Local Group Policy Editor and navigate to: Computer Configuration → Administrative Templates → Windows Components → Windows PowerShell.",
          "Turn on Script Execution > Enabled; Execution Policy > \"Allow local Scripts and remote signed scripts\".",
          "This configuration allows locally created scripts to run while maintaining security for remotely downloaded scripts."
        ]
      }
