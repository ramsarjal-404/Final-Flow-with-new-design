    "WINRM_STEPS": [
      {
        "id": "enable",
        "title": "1. Enable WinRM Service",
        "body": [
          "Ensure that the Windows Remote Management (WinRM) service is enabled and running on both systems."
        ]
      },
      {
        "id": "trusted-hosts",
        "title": "2. Configure Trusted Hosts",
        "body": [
          "Run the following command on the LDSP Host using PowerShell or Command Prompt with Administrator privileges."
        ],
        "commands": [
          {
            "label": "Trust All Servers (Not Recommended)",
            "command": "winrm set winrm/config/client @{TrustedHosts=\"*\"}"
          },
          {
            "label": "Trust a Specific Server (Recommended)",
            "command": "winrm set winrm/config/client @{TrustedHosts=\"192.168.1X.1XX\"}"
          }
        ],
        "footnote": "Incorrect TrustedHosts configuration may cause remote scanning or policy execution failures."
      },
      {
        "id": "script-execution",
        "title": "3. Configure PowerShell Script Execution",
        "body": [
          "Open the Local Group Policy Editor:",
          "Navigate to:"
        ],
        "steps": [
          "1 → Computer Configuration",
          "2 → Administrative Templates",
          "3 → Windows Components",
          "4 → Windows PowerShell",
          "5 → Turn on Script Execution > Enabled",
          "6 → Execution Policy > \"Allow local Scripts and remote signed scripts\""
        ],
        "footnote": "This configuration allows locally created scripts to run while maintaining security for remotely downloaded scripts."
      }
    ]
