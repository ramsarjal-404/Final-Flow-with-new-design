{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lepide console flow",
  "description": "A flow of the Lepide console prototype, documented for people and AI tools. See flows/README.md.",
  "type": "object",
  "required": ["id", "title", "designSystem", "code", "routes"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "version": { "type": "string" },
    "source": { "type": "object", "description": "Where the flow's content came from (e.g. a Figma file). Content only, never styling." },
    "designSystem": { "type": "object", "required": ["mcp", "specInRepo"] },
    "code": { "type": "object", "additionalProperties": { "type": "string", "description": "A file in this repository" } },
    "routes": { "type": "array", "items": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" }, "screen": { "type": "string" }, "note": { "type": "string" } } } },
    "entry": { "type": "object" },
    "screens": { "type": "array", "items": { "$ref": "#/$defs/view" } },
    "wizard": {
      "type": "object",
      "properties": {
        "steps": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/view" }, { "required": ["id", "label"] }] } }
      }
    },
    "dialogs": { "type": "array", "items": { "allOf": [{ "$ref": "#/$defs/view" }, { "required": ["id", "title"] }] } },
    "data": { "type": "object" },
    "notBuilt": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "view": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "label": { "type": "string" },
        "screenshot": { "type": "string", "description": "Path relative to the flow folder" },
        "components": { "type": "array", "items": { "type": "string", "description": "A design-system component page: docs/components/<name>.md" } },
        "fields": { "type": "array", "items": { "type": "object", "required": ["id"] } },
        "errors": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
