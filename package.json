{
  "name": "lepide-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview --port 5175",
    "catalog": "node scripts/screens-catalog.mjs",
    "screens:ad": "node scripts/screens-ad.mjs",
    "screens:shield": "node scripts/screens-shield.mjs",
    "check:ai": "node scripts/check-ai.mjs",
    "check:ai:online": "node scripts/check-ai.mjs --online"
  },
  "dependencies": {
    "@lepide/ds-css": "https://lepide-new-ds.vercel.app/ds/lepide-ds-css.tgz",
    "@lepide/ds-react": "https://lepide-new-ds.vercel.app/ds/lepide-ds-react.tgz",
    "highcharts": "^13.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
